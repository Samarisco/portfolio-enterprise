{
  "name": "portfolio-enterprise",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @portfolio/api db:generate",
    "db:migrate": "pnpm --filter @portfolio/api db:migrate",
    "db:seed": "pnpm --filter @portfolio/api db:seed"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "eslint": "9.39.4",
    "prettier": "3.8.3",
    "turbo": "2.9.14",
    "typescript": "6.0.3"
  }
}
